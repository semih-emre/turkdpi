#!/usr/bin/env bash
set -euo pipefail

interface_name=${1-}
event_name=${2-}

case "$event_name" in
  up|dhcp4-change|dhcp6-change)
    if /usr/bin/systemctl is-enabled --quiet turkdpi.service; then
      service_state=$(/usr/bin/systemctl is-active turkdpi.service 2>/dev/null || true)
      case "$service_state" in
        activating|deactivating)
          exit 0
          ;;
        active)
          marker_uuid=
          if [[ -r /var/lib/turkdpi/dns-connection ]]; then
            IFS= read -r marker_uuid </var/lib/turkdpi/dns-connection || true
          fi
          if [[ -n ${CONNECTION_UUID-} && ${CONNECTION_UUID} == "$marker_uuid" ]]; then
            exit 0
          fi
          /usr/bin/systemctl try-restart turkdpi.service
          ;;
        *)
          /usr/bin/systemctl start turkdpi.service
          ;;
      esac
    fi
    ;;
  connectivity-change)
    if /usr/bin/systemctl is-enabled --quiet turkdpi.service; then
      service_state=$(/usr/bin/systemctl is-active turkdpi.service 2>/dev/null || true)
      case "$service_state" in
        active|activating|deactivating) ;;
        *) /usr/bin/systemctl start turkdpi.service ;;
      esac
    fi
    ;;
  down)
    /usr/bin/systemctl try-stop turkdpi.service
    ;;
esac

# NetworkManager supplies this value; it is deliberately never interpolated into a command.
: "$interface_name"
