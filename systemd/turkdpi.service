[Unit]
Description=TurkDPI Discord DPI resilience engine
Documentation=file:/usr/share/doc/turkdpi/README.md
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/turkdpi-service auto
ExecStop=/usr/bin/turkdpi-service cleanup
TimeoutStartSec=90
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
RuntimeDirectory=turkdpi
StateDirectory=turkdpi
ReadWritePaths=/run/turkdpi /var/lib/turkdpi

[Install]
WantedBy=multi-user.target
